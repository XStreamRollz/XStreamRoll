{
  "name": "stellar-streaming-api",
  "version": "1.0.0",
  "description": "Stellar Streaming API built with NestJS",
  "main": "dist/main.js",
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "migrate": "node-pg-migrate -m ../database/migrations up",
    "migrate:down": "node-pg-migrate -m ../database/migrations down 1",
    "migrate:redo": "node-pg-migrate -m ../database/migrations redo",
    "migrate:create": "node-pg-migrate -m ../database/migrations --migration-file-language sql create"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/platform-socket.io": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.29",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "fast-check": "^4.9.0",
    "helmet": "8.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "cookie-parser": "^1.4.6",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "xstreamroll": "file:..",
    "@xstreamroll/types": "file:../packages/types",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "@xstreamroll/contract-tests": "file:../tests/contracts",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
