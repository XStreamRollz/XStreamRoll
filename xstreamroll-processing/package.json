{
  "name": "stellar-stream-processor",
  "version": "1.0.0",
  "description": "Stream processing worker for Stellar Streaming",
  "main": "dist/worker.js",
  "scripts": {
    "start": "node dist/worker.js",
    "dev": "ts-node src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint --config ../eslint.config.js src __tests__"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "forceExit": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text"
    ]
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.20.0",
    "jest": "^30.5.0",
    "nock": "^14.0.17",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^7.0.2"
  }
}
