{
  "name": "stellar-streaming-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "analyze": "cross-env ANALYZE=true npm run build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit"
